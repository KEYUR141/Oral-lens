# Edit .env; never commit real credentials. DB_* passwords need no URL encoding.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=oral_cancer_rag
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5

# Optional complete PostgreSQL URL; overrides DB_* fields. Percent-encode URL passwords.
# Put provider-specific SSL options in this URL if using it.
DATABASE_URL=

# Change to false only before intentional ingestion/schema writes.
DB_READ_ONLY=true

# Relative paths resolve against the Oral-lens repository.
DATA_DIR=data
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
HF_HOME=.cache/huggingface
WARM_UP_UMAP=false

# Inherited retrieval-and-answer baseline; disabled while the new review workflow is built.
ENABLE_LEGACY_QUERY=false

# Meta Model API configuration used by app/muse.py and test_muse_llm.py.
Meta_Muse_API_KEY=
Meta_Muse_MODEL=muse-spark-1.3

# No discovery runs automatically.
PAPER_SEARCH_QUERY=oral squamous cell carcinoma
PAPER_SEARCH_YEARS=2012-2026
SEMANTIC_SCHOLAR_API_KEY=
